// use prisma-8
enum Role {
  @@type("pg/text@1")
  ADMIN = "ADMIN"
  EMPLOYEE = "EMPLOYEE"
}

enum AttendanceStatus {
  @@type("pg/text@1")
  PRESENT = "PRESENT"
  LATE = "LATE"
  ABSENT = "ABSENT"
  LEAVE = "LEAVE"
}

model User {
  id          String                     @id @default(uuid())
  email       String                     @unique
  name        String
  password    String
  role        Role                       @default(EMPLOYEE)
  isActive    Boolean                    @default(true)
  attendances Attendance[]
  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()
}

model Attendance {
  id          String                     @id @default(uuid())
  userId      String
  user        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateString
  checkIn     TimestamptzString?
  checkInLat  Float?
  checkInLng  Float?
  checkOut    TimestamptzString?
  checkOutLat Float?
  checkOutLng Float?
  status      AttendanceStatus           @default(PRESENT)
  lateMinutes       Int                        @default(0)
  earlyLeaveMinutes Int                        @default(0)
  notes             String?
  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model SystemSetting {
  id                   String            @id @default(uuid())
  key                  String            @unique @default("DEFAULT_SCHEDULE")
  workStartTime        String            @default("08:00")
  workEndTime          String            @default("17:00")
  lateToleranceMinutes Int               @default(15)
  createdAt            TimestamptzString @default(now())
  updatedAt            temporal.updatedAtString()
}